  },
  "license": "MIT",
  "dependencies": {
    "@mujoco/mujoco": "^3.17.0",
    "acorn": "^8.19.0",
    "blockly": "^13.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "acorn-walk": "^8.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
