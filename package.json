{
  "name": "pai-sim",
  "version": "0.0.0",
  "description": "Browser robotics sim: build, run, share and remix robots from a link",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
